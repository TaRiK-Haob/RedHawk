# LLM — required
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional: cheaper model for recon sub-agents (falls back to DEEPSEEK_MODEL)
# DEEPSEEK_MODEL_RECON=deepseek-v4-flash

# Web search — optional (leave empty to disable web search)
TAVILY_API_KEY=tvly-dev-...
EXA_API_KEY=...
